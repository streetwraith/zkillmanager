# zkillmanager configuration (12-factor env vars).
#
# Local dev: `cp .env.example .env` then `go run ./cmd/zkillmanager` -- the app auto-loads
# .env if present (real env vars still take precedence). In prod, Coolify injects these
# (no .env in the container, so auto-load is a no-op).
#
# Prereq for local dev: run `DUMP_SCHEMAS=sde ~/sync-prod-db.sh` first -- it creates the
# zkillmanager role + the killmails schema locally and loads the sde reference data.

# Postgres DSN. Local dev connects as the unprivileged `zkillmanager` role.
DATABASE_URL="postgres://zkillmanager:zkillmanager@127.0.0.1:55432/eve?sslmode=disable"

# Descriptive User-Agent (zKillboard etiquette): app + contact URL + email.
# Prod uses https://lscan.entropiadev.com instead of the test. subdomain.
USER_AGENT="zkillmanager/1.0 (+https://test.lscan.entropiadev.com; lscan@entropiadev.com)"

# Retention = backfill depth (days). Small locally so backfill pulls only a few dumps.
RETENTION_DAYS=3
BACKFILL_ON_START=true

# Optional (defaults shown):
# HISTORY_BASE_URL="https://r2z2.zkillboard.com/history"
# LIVE_BASE_URL="https://r2z2.zkillboard.com/ephemeral"
# RECONCILE_INTERVAL=1h
# PRUNE_INTERVAL=24h
# HTTP_ADDR=":8080"
